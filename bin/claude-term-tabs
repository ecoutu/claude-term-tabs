#!/usr/bin/env node
import { existsSync, realpathSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { pathToFileURL } from 'node:url'

const root = dirname(dirname(realpathSync(process.argv[1])))
const argv = process.argv.slice(2)
// A checkout runs the TypeScript in src/; the npm package ships only dist/, because Node won't strip types under node_modules.
const fromSrc = existsSync(join(root, 'src')) && !root.split('/').includes('node_modules')
const src = file => pathToFileURL(fromSrc ? join(root, 'src', file) : join(root, 'dist', file.replace(/\.ts$/, '.js'))).href
const { COMPLETE_FLAG, answerCompletion } = await import(src('complete.ts'))
if (argv[0] === COMPLETE_FLAG) {
  // A Tab press: answer without loading the rest of ctt.
  const { lineWriter } = await import(src('output.ts'))
  process.exitCode = answerCompletion(argv.slice(1), { stdout: lineWriter(1), stderr: lineWriter(2) })
} else {
  const { main } = await import(src('cli.ts'))
  process.exitCode = await main(argv, { installed: !fromSrc })
}
