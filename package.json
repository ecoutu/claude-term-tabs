{
  "name": "claude-term-tabs",
  "version": "0.0.0-development",
  "description": "Find a running Claude Code session by what you remember, and jump to its terminal tab",
  "type": "module",
  "license": "MIT",
  "author": "Emma Coutu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecoutu/claude-term-tabs.git"
  },
  "homepage": "https://github.com/ecoutu/claude-term-tabs#readme",
  "bugs": {
    "url": "https://github.com/ecoutu/claude-term-tabs/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "iterm2",
    "wezterm",
    "terminal",
    "tabs",
    "cli"
  ],
  "bin": {
    "claude-term-tabs": "bin/claude-term-tabs",
    "ctt": "bin/claude-term-tabs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "CTT_NO_REAL_EXEC=1 node --test 'tests/**/*.test.ts'",
    "check": "tsc",
    "prepare": "husky",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:package": "CTT_NO_REAL_EXEC=1 node --test 'tests/**/*.pack.ts'"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "24.19.2",
    "husky": "9.1.7",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3"
  }
}
